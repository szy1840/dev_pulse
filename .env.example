# ---- InsForge backend ----
# Get URL from `.insforge/project.json` (oss_host) and the anon key via
#   npx @insforge/cli secrets get ANON_KEY
NEXT_PUBLIC_INSFORGE_URL="https://your-appkey.us-east.insforge.app"
NEXT_PUBLIC_INSFORGE_ANON_KEY="eyJhbGciOiJIUzI1NiIs..."

# Server-only full-access admin (service) key — from `.insforge/project.json` (api_key).
# Never expose this with a NEXT_PUBLIC_ prefix.
INSFORGE_URL="https://your-appkey.us-east.insforge.app"
INSFORGE_API_KEY="ik_xxx"

# ---- AI summaries (OpenRouter via InsForge) ----
# Populate with: npx @insforge/cli ai setup   (server-only; never NEXT_PUBLIC_)
OPENROUTER_API_KEY="sk-or-v1-xxx"
# Optional override; defaults to anthropic/claude-haiku-4.5
# OPENROUTER_CHAT_MODEL="anthropic/claude-haiku-4.5"

# Optional: protects POST /api/cron/daily-summaries. Set the same value as a
# secret and pass it as `Authorization: Bearer <CRON_SECRET>` from the scheduler.
# CRON_SECRET="some-long-random-string"

# Public base URL of the deployed app. The CLI uses this when syncing if set via DEVPULSE_API_URL.
# Production: https://7aj5nkyd.insforge.site
# Local dev: http://localhost:3000
NEXT_PUBLIC_APP_URL="http://localhost:3000"
